{
  "name": "cellforge",
  "private": true,
  "description": "A spreadsheet that stays fast at 100M rows, entirely in the browser",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cellforge/web",
    "build": "npm run build -w @cellforge/web",
    "typecheck": "tsc --noEmit -p apps/web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
